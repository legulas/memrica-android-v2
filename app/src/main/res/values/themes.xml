<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Memrica" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.Memrica.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Memrica</item>
    </style>

    <color name="background">#F5F5F5</color>
    <color name="teal">#00ACC1</color>
</resources>
